# Copy to .env (next to docker-compose.yml) to change how the demo runs.
# Docker Compose reads .env automatically; every value here is optional.

# Reservation hold length in seconds (default 900 = 15 minutes).
# 60 lets you show a hold expiring, and its payment being voided, live.
# RESERVATION_HOLD_SECONDS=60

# Seed the demo data and machine keys on start (default 1). 0 for an empty system.
# DEMO_INIT=1

# Database credentials (only change before the first start: they are baked
# into the database volume).
# POSTGRES_USER=carepoint
# POSTGRES_PASSWORD=carepoint
# POSTGRES_DB=carepoint
