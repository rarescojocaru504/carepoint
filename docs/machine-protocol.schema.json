{
  "$defs": {
    "Ack": {
      "description": "The message `reply_to` was accepted and applied.",
      "properties": {
        "reply_to": {
          "title": "Reply To",
          "type": "string"
        },
        "type": {
          "const": "ack",
          "default": "ack",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reply_to"
      ],
      "title": "Ack",
      "type": "object"
    },
    "Dispense": {
      "description": "Command: release `quantity` units from `slot`. Execute each `command_id`\nat most once; if it arrives again, resend its result instead.",
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "integer"
        },
        "reservation_id": {
          "format": "uuid",
          "title": "Reservation Id",
          "type": "string"
        },
        "slot": {
          "title": "Slot",
          "type": "string"
        },
        "type": {
          "const": "dispense",
          "default": "dispense",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "command_id",
        "reservation_id",
        "slot",
        "quantity"
      ],
      "title": "Dispense",
      "type": "object"
    },
    "DispenseResult": {
      "additionalProperties": false,
      "description": "What happened to a `dispense` command. Send once per command, and again\n(same content) if it was not acknowledged before a disconnect.",
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/MachineErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "description": "Chosen by the machine; echoed as `reply_to`.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "dispensed",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "type": {
          "const": "dispense_result",
          "title": "Type",
          "type": "string"
        },
        "units_dispensed": {
          "maximum": 10,
          "minimum": 0,
          "title": "Units Dispensed",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "type",
        "command_id",
        "outcome",
        "units_dispensed"
      ],
      "title": "DispenseResult",
      "type": "object"
    },
    "Error": {
      "description": "The message `reply_to` was rejected and nothing of it was applied.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProtocolErrorCode"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null if the message had no readable id",
          "title": "Reply To"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reply_to",
        "code",
        "detail"
      ],
      "title": "Error",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "description": "A fault the machine detected.",
      "properties": {
        "code": {
          "$ref": "#/$defs/MachineErrorCode"
        },
        "id": {
          "description": "Chosen by the machine; echoed as `reply_to`.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "pattern": "^[^\\x00-\\x1f\\x7f]{1,200}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "slot": {
          "anyOf": [
            {
              "pattern": "^[A-Z][0-9]{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot"
        },
        "type": {
          "const": "error_event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "code"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "Heartbeat": {
      "additionalProperties": false,
      "description": "Send every `heartbeat_interval_seconds` (from `welcome`).",
      "properties": {
        "firmware_version": {
          "pattern": "^[A-Za-z0-9._+-]{1,32}$",
          "title": "Firmware Version",
          "type": "string"
        },
        "id": {
          "description": "Chosen by the machine; echoed as `reply_to`.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "heartbeat",
          "title": "Type",
          "type": "string"
        },
        "uptime_seconds": {
          "maximum": 315360000,
          "minimum": 0,
          "title": "Uptime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "type",
        "firmware_version",
        "uptime_seconds"
      ],
      "title": "Heartbeat",
      "type": "object"
    },
    "MachineErrorCode": {
      "description": "Faults a machine can report (docs/machine-protocol.md).",
      "enum": [
        "jam",
        "motor_fault",
        "sensor_fault",
        "door_forced",
        "temperature_out_of_range",
        "power_loss",
        "other"
      ],
      "title": "MachineErrorCode",
      "type": "string"
    },
    "MachineToServer": {
      "discriminator": {
        "mapping": {
          "dispense_result": "#/$defs/DispenseResult",
          "error_event": "#/$defs/ErrorEvent",
          "heartbeat": "#/$defs/Heartbeat",
          "stock_report": "#/$defs/StockReport",
          "telemetry": "#/$defs/Telemetry",
          "verify_code": "#/$defs/VerifyCode"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Heartbeat"
        },
        {
          "$ref": "#/$defs/Telemetry"
        },
        {
          "$ref": "#/$defs/StockReport"
        },
        {
          "$ref": "#/$defs/ErrorEvent"
        },
        {
          "$ref": "#/$defs/VerifyCode"
        },
        {
          "$ref": "#/$defs/DispenseResult"
        }
      ]
    },
    "PickupRefusal": {
      "enum": [
        "invalid_code",
        "too_many_attempts",
        "pickup_in_progress",
        "machine_unavailable"
      ],
      "title": "PickupRefusal",
      "type": "string"
    },
    "ProtocolErrorCode": {
      "enum": [
        "invalid_message",
        "unknown_slot",
        "out_of_range",
        "slot_not_configured",
        "unknown_command",
        "internal_error"
      ],
      "title": "ProtocolErrorCode",
      "type": "string"
    },
    "ServerToMachine": {
      "discriminator": {
        "mapping": {
          "ack": "#/$defs/Ack",
          "dispense": "#/$defs/Dispense",
          "error": "#/$defs/Error",
          "verify_result": "#/$defs/VerifyResult",
          "welcome": "#/$defs/Welcome"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Welcome"
        },
        {
          "$ref": "#/$defs/Ack"
        },
        {
          "$ref": "#/$defs/Error"
        },
        {
          "$ref": "#/$defs/VerifyResult"
        },
        {
          "$ref": "#/$defs/Dispense"
        }
      ]
    },
    "SlotCount": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "slot": {
          "pattern": "^[A-Z][0-9]{1,2}$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "quantity"
      ],
      "title": "SlotCount",
      "type": "object"
    },
    "StockReport": {
      "additionalProperties": false,
      "description": "Units physically in each listed slot, as counted by the machine now.",
      "properties": {
        "id": {
          "description": "Chosen by the machine; echoed as `reply_to`.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/SlotCount"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Slots",
          "type": "array"
        },
        "type": {
          "const": "stock_report",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "slots"
      ],
      "title": "StockReport",
      "type": "object"
    },
    "Telemetry": {
      "additionalProperties": false,
      "description": "Door and cabinet temperature; send on change and with every heartbeat.",
      "properties": {
        "door": {
          "enum": [
            "open",
            "closed"
          ],
          "title": "Door",
          "type": "string"
        },
        "id": {
          "description": "Chosen by the machine; echoed as `reply_to`.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "temperature_c": {
          "maximum": 85.0,
          "minimum": -40.0,
          "title": "Temperature C",
          "type": "number"
        },
        "type": {
          "const": "telemetry",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "door",
        "temperature_c"
      ],
      "title": "Telemetry",
      "type": "object"
    },
    "VerifyCode": {
      "additionalProperties": false,
      "description": "A customer typed a pickup code or scanned its QR code.",
      "properties": {
        "credential": {
          "description": "6-digit code, or the QR payload CP1:<id>:<code>",
          "pattern": "^[\\x20-\\x7e]{1,64}$",
          "title": "Credential",
          "type": "string"
        },
        "id": {
          "description": "Chosen by the machine; echoed as `reply_to`.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "verify_code",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "credential"
      ],
      "title": "VerifyCode",
      "type": "object"
    },
    "VerifyResult": {
      "description": "Reply to `verify_code`. When `ok`, a `dispense` command follows at once.",
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the dispense that follows",
          "title": "Command Id"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "refusal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PickupRefusal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reply_to": {
          "title": "Reply To",
          "type": "string"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "with too_many_attempts: when the keypad works again",
          "title": "Retry After Seconds"
        },
        "type": {
          "const": "verify_result",
          "default": "verify_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reply_to",
        "ok",
        "refusal",
        "retry_after_seconds",
        "command_id"
      ],
      "title": "VerifyResult",
      "type": "object"
    },
    "Welcome": {
      "description": "First message after the handshake.",
      "properties": {
        "heartbeat_interval_seconds": {
          "title": "Heartbeat Interval Seconds",
          "type": "integer"
        },
        "machine_id": {
          "format": "uuid",
          "title": "Machine Id",
          "type": "string"
        },
        "protocol": {
          "default": 1,
          "title": "Protocol",
          "type": "integer"
        },
        "serial_number": {
          "title": "Serial Number",
          "type": "string"
        },
        "server_time": {
          "format": "date-time",
          "title": "Server Time",
          "type": "string"
        },
        "type": {
          "const": "welcome",
          "default": "welcome",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocol",
        "machine_id",
        "serial_number",
        "server_time",
        "heartbeat_interval_seconds"
      ],
      "title": "Welcome",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CarePoint machine protocol v1 (carepoint.v1)"
}
